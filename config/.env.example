# Example: .env.example file
# Copy this to config/.env and update with your values

# Database Configuration
DB_CONNECTION_STRING=postgresql+asyncpg://user:password@localhost:9002/postgres
DB_HOST=localhost
DB_PORT=9002
DB_NAME=postgres
DB_USER=user
DB_PASSWORD=password

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu  # or 'cuda' for GPU

# Index Configuration
DEFAULT_INDEX_TYPE=hnsw  # hnsw, ivfflat, or diskann
DEFAULT_DISTANCE_METRIC=cosine  # cosine, l2, or inner_product

# HNSW Parameters
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40

# IVFFlat Parameters
IVFFLAT_LISTS=100
IVFFLAT_PROBES=10

# DiskANN Parameters
DISKANN_NUM_NEIGHBORS=50
DISKANN_SEARCH_LIST_SIZE=100

# Search Defaults
DEFAULT_K=5
DEFAULT_HYBRID_WEIGHTS=0.5,0.5

# Performance
CONNECTION_POOL_MIN_SIZE=2
CONNECTION_POOL_MAX_SIZE=10
CONNECTION_TIMEOUT=30
BATCH_SIZE=100

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/pgvectordb.log
