# Example: .env.example file
# Copy this to config/.env and update with your values

# ============================================================================
# Environment Configuration
# ============================================================================
ENVIRONMENT=local  # local, remote, or test

# ============================================================================
# Embedding Configuration
# ============================================================================
EMBEDDING_PROVIDER=huggingface  # huggingface or bedrock

# HuggingFace Settings
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_DEVICE=cpu  # cpu or cuda

# AWS Bedrock Settings (only needed if EMBEDDING_PROVIDER=bedrock)
# Option 1: Simple model ID (provider auto-extracted)
BEDROCK_MODEL_ID=amazon.titan-embed-text-v1

# Option 2: ARN with explicit provider (recommended)
# BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v1
# BEDROCK_PROVIDER=amazon

# Option 3: ARN without extractable provider (must set BEDROCK_PROVIDER)
# BEDROCK_MODEL_ID=arn:aws:bedrock:us-west-2:123456789012:provisioned-model/xxxxxxxxxx
# BEDROCK_PROVIDER=cohere

# Provider options: amazon, cohere, anthropic, ai21, meta, mistral, stability
BEDROCK_PROVIDER=

AWS_REGION=us-east-1

# Optional: Leave empty to use default AWS credentials
# Priority: 1) These vars, 2) ~/.aws/credentials, 3) Environment vars, 4) IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ============================================================================
# Database Configuration - Local (for tests and development)
# ============================================================================
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=9002
LOCAL_DB_NAME=postgres
LOCAL_DB_USER=user
LOCAL_DB_PASSWORD=root

# ============================================================================
# Database Configuration - Remote (for production)
# ============================================================================
REMOTE_DB_HOST=your-remote-host.example.com
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=postgres
REMOTE_DB_USER=user
REMOTE_DB_PASSWORD=root

# Index Configuration
DEFAULT_INDEX_TYPE=hnsw  # hnsw, ivfflat, or diskann
DEFAULT_DISTANCE_METRIC=cosine  # cosine, l2, or inner_product

# HNSW Parameters
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40

# IVFFlat Parameters
IVFFLAT_LISTS=100
IVFFLAT_PROBES=10

# DiskANN Parameters
DISKANN_NUM_NEIGHBORS=50
DISKANN_SEARCH_LIST_SIZE=100

# Search Defaults
DEFAULT_K=5
DEFAULT_HYBRID_WEIGHTS=0.5,0.5

# Performance
CONNECTION_POOL_MIN_SIZE=2
CONNECTION_POOL_MAX_SIZE=10
CONNECTION_TIMEOUT=30
BATCH_SIZE=100

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/pgvectordb.log
